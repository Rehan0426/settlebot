# Copy this file to .env and fill in your real keys.
# .env is git-ignored, so your keys stay on your machine.

# Primary model provider (Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Fallback provider, used when Gemini fails or is not configured (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: Groq models to try, in order. Defaults to the list below if unset.
# GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b
